-- === ЛОГИКА ПРОВЕРКИ ===
local isVerifying = false

verifyBtn.MouseButton1Click:Connect(function()
	if isVerifying then return end
	isVerifying = true
	verifyBtn.Text = "<b>...</b>"

	local inputKey = keyInput.Text
	local success, targetKey = pcall(function()
		return game:HttpGet("https://raw.githubusercontent.com/simbademor-lang/S4nxHub/main/k3y")
	end)

	local keyMatches = false
	if success and targetKey then
		targetKey = string.gsub(targetKey, "%s+", "")
		inputKey = string.gsub(inputKey, "%s+", "")
		if inputKey == targetKey then keyMatches = true end
	end

	if keyMatches then
		_G.KeyVerified = true
		verifyBtn.Text = "<b><font color='#80FF80'>Success</font></b>"
		task.wait(1)
		
		-- Эпичное закрытие
		TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Rotation = 45
		}):Play()
		task.wait(0.6)
		screenGui:Destroy()
	else
		verifyBtn.Text = "<b><font color='#FF4040'>Wrong Key!</font></b>"
		
		-- Тряска (Shake Effect)
		local origPos = mainFrame.Position
		for i = 1, 6 do
			mainFrame.Position = origPos + UDim2.new(0, (i%2==0 and 15 or -15), 0, 0)
			task.wait(0.04)
		end
		mainFrame.Position = origPos
		
		task.wait(1)
		verifyBtn.Text = "<b>Verify</b>"
		isVerifying = false
	end
end)

repeat task.wait(0.5) until _G.KeyVerified
