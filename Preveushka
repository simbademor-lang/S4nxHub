local isVerifying = false

verifyBtn.MouseButton1Click:Connect(function()
	if isVerifying then return end
	isVerifying = true
	clickSound:Play()
	verifyBtn.Text = "..."

	local inputKey = keyInput.Text
	local success, targetKey = pcall(function()
		return game:HttpGet("https://raw.githubusercontent.com/simbademor-lang/S4nxHub/main/k3y")
	end)

	local keyMatches = false
	if success and targetKey then
		targetKey = string.gsub(targetKey, "%s+", "")
		inputKey = string.gsub(inputKey, "%s+", "")
		if inputKey == targetKey then keyMatches = true end
	end

	if keyMatches then
		_G.KeyVerified = true
		successSound:Play()
		verifyBtn.Text = "SUCCESS"
		verifyBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		
		strokeGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 255, 50)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 255, 50))
		})

		TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = mainFrame.Position - UDim2.new(0, 0, 0.05, 0)
		}):Play()
		task.wait(0.3)
		
		TweenService:Create(mainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Position = mainFrame.Position + UDim2.new(0, 0, 1.5, 0),
			Rotation = 15
		}):Play()
		
		for _, v in pairs(mainFrame:GetDescendants()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
				TweenService:Create(v, TweenInfo.new(0.5), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
			elseif v:IsA("Frame") or v:IsA("ScrollingFrame") then
				TweenService:Create(v, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
			elseif v:IsA("UIStroke") then
				TweenService:Create(v, TweenInfo.new(0.5), {Transparency = 1}):Play()
			end
		end

		task.wait(0.8)
		screenGui:Destroy()
		
		task.spawn(function()
			local fade = TweenService:Create(bgMusic, TweenInfo.new(2, Enum.EasingStyle.Linear), {Volume = 0})
			fade:Play()
			fade.Completed:Wait()
			soundFolder:Destroy()
		end)
	else
		errorSound:Play()
		verifyBtn.Text = "WRONG KEY"
		verifyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
		
		local origColor = strokeGradient.Color
		strokeGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 50, 50)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 50))
		})

		local origPos = mainFrame.Position
		for i = 1, 5 do
			TweenService:Create(mainFrame, TweenInfo.new(0.05, Enum.EasingStyle.Sine), {
				Position = origPos + UDim2.new(0, (i % 2 == 0 and 10 or -10), 0, 0)
			}):Play()
			task.wait(0.05)
		end
		TweenService:Create(mainFrame, TweenInfo.new(0.05, Enum.EasingStyle.Sine), {Position = origPos}):Play()
		
		task.wait(1)
		verifyBtn.Text = "Verify"
		verifyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		strokeGradient.Color = origColor
		isVerifying = false
	end
end)

repeat task.wait(0.5) until _G.KeyVerified
