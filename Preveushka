local bgFolder = Instance.new("Folder", mainFrame)
local function spawnDNA()
	task.spawn(function()
		while mainFrame.Parent do
			local node = Instance.new("TextLabel", bgFolder)
			node.BackgroundTransparency = 1
			node.Text = (math.random(1, 2) == 1) and "0" or "1"
			if math.random(1, 3) == 3 then node.Text = "." end
			node.TextColor3 = Color3.fromRGB(80, 80, 100)
			node.TextSize = math.random(12, 20)
			node.TextTransparency = 1
			
			local startX = math.random(0, 100)/100
			local endX = startX + (math.random(-20, 20)/100)
			node.Position = UDim2.new(startX, 0, 1.1, 0)
			
			local flightInfo = TweenInfo.new(math.random(5, 10), Enum.EasingStyle.Linear)
			TweenService:Create(node, flightInfo, {Position = UDim2.new(endX, 0, -0.2, 0)}):Play()
			TweenService:Create(node, TweenInfo.new(1), {TextTransparency = 0.5}):Play()
			
			task.wait(flightInfo.Time - 1)
			TweenService:Create(node, TweenInfo.new(1), {TextTransparency = 1}):Play()
			task.wait(1)
			node:Destroy()
		end
	end)
end
for i = 1, 15 do spawnDNA() task.wait(math.random(1, 5)/10) end

