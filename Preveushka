lineRight.BorderSizePixel = 0
lineRight.Position = UDim2.new(1, 0, 0.5, -2)
lineRight.Size = UDim2.new(0.5, 0, 0, 2)

TweenService:Create(lineLeft, infoSmooth, {Position = UDim2.new(0, 0, 0.5, -2)}):Play()
local tLineRight = TweenService:Create(lineRight, infoSmooth, {Position = UDim2.new(0.5, 0, 0.5, -2)})
tLineRight:Play()
tLineRight.Completed:Wait()

local emojis = {"✨", "💫", "🚀", "🪐", "⚡"}
for i = 1, 30 do
	local emoji = Instance.new("TextLabel", introFrame)
	emoji.BackgroundTransparency = 1
	emoji.Text = emojis[math.random(1, #emojis)]
	emoji.TextSize = math.random(20, 45)
	emoji.Position = UDim2.new(math.random(20, 80)/100, 0, -0.2, 0)
	emoji.Rotation = math.random(-180, 180)
	
	local dropTime = math.random(10, 25) / 10
	TweenService:Create(emoji, TweenInfo.new(dropTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
		Position = UDim2.new(emoji.Position.X.Scale, 0, 1.2, 0),
		Rotation = emoji.Rotation + math.random(180, 360)
	}):Play()
	task.wait(0.05)
end

task.wait(0.5)
TweenService:Create(lineLeft, infoFast, {Position = UDim2.new(-0.5, 0, 0.5, -2)}):Play()
TweenService:Create(lineRight, infoFast, {Position = UDim2.new(1, 0, 0.5, -2)}):Play()
