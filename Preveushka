local lineLeft = Instance.new("Frame", introFrame)
lineLeft.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
lineLeft.BorderSizePixel = 0
lineLeft.Position = UDim2.new(-0.5, 0, 0.5, -2)
