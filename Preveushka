mainStroke.Color = Color3.fromRGB(255, 255, 255)

local strokeGradient = Instance.new("UIGradient", mainStroke)
strokeGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 80, 255)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 80, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 80, 255))
})

-- Анимация контура
RunService.RenderStepped:Connect(function()
	strokeGradient.Rotation = (strokeGradient.Rotation + 1) % 360
end)

-- Фон с цифрами и ДНК (0, 1, точки)
local bgNodes = Instance.new("Folder", mainFrame)
local nodes = {}
for i = 1, 25 do
	local node = Instance.new("TextLabel", mainFrame)
	node.BackgroundTransparency = 1
	node.Text = (math.random(1, 2) == 1) and "0" or (math.random(1, 2) == 1 and "1" or ".")
	node.TextColor3 = Color3.fromRGB(60, 60, 80)
	node.TextSize = math.random(10, 18)
	node.Position = UDim2.new(math.random(0, 100)/100, 0, math.random(0, 100)/100, 0)
	table.insert(nodes, {element = node, speedX = math.random(-10, 10)/10000, speedY = math.random(-10, 10)/10000})
end

RunService.RenderStepped:Connect(function()
	for _, n in pairs(nodes) do
		local curX = n.element.Position.X.Scale
		local curY = n.element.Position.Y.Scale
		if curX < 0 or curX > 1 then n.speedX = -n.speedX end
		if curY < 0 or curY > 1 then n.speedY = -n.speedY end
		n.element.Position = UDim2.new(curX + n.speedX, 0, curY + n.speedY, 0)
	end
end)

-- Раскрываем фрейм
TweenService:Create(mainFrame, infoSmooth, {Size = UDim2.new(0, 420, 0, 240)}):Play()
task.wait(0.5)

-- Анимация сборки букв S4nx Hub
local titleWord = "S4nx Hub"
local letters = {}
local letterContainer = Instance.new("Frame", mainFrame)
letterContainer.Size = UDim2.new(1, 0, 0.3, 0)
letterContainer.BackgroundTransparency = 1
letterContainer.Position = UDim2.new(0, 0, 0.1, 0)

local startX = 0.25
local spacing = 0.07

for i = 1, #titleWord do
	local char = string.sub(titleWord, i, i)
	local l = Instance.new("TextLabel", letterContainer)
	l.BackgroundTransparency = 1
	l.Text = char
	l.Font = Enum.Font.Roboto
	l.RichText = true
	l.Text = "<b>" .. char .. "</b>"
	l.TextColor3 = Color3.fromRGB(255, 255, 255)
	l.TextSize = 34
	-- Падают с неба случайным образом
	l.Position = UDim2.new(math.random(10, 90)/100, 0, -2, 0)
	l.Rotation = math.random(-360, 360)
	l.Size = UDim2.new(0, 30, 1, 0)
	
	TweenService:Create(l, infoBounce, {
		Position = UDim2.new(startX + (i-1)*spacing, 0, 0, 0),
		Rotation = 0
	}):Play()
	task.wait(0.08)
	table.insert(letters, l)
end

task.wait(1)

